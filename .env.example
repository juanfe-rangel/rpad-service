NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://rpad:replace_me@localhost:5432/rpad?schema=public

# JWT RS256 backend integration
AUTH_JWKS_URI=https://identity.example/.well-known/jwks.json
AUTH_ISSUER=https://identity.example/
AUTH_AUDIENCE=rpad-service
AUTH_ROLES_CLAIM=roles
AUTH_USER_ID_CLAIM=sub

# Private Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=rpad-evidence
EVIDENCE_UPLOAD_TTL_SECONDS=600
EVIDENCE_READ_TTL_SECONDS=300

# Azure Service Bus topic; outbox remains pending when unset
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_TOPIC=rpad-events
